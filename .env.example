# 环境变量配置
# 复制此文件为 .env 并填写实际值

# ========== 必填 ==========

# Cloudflare Worker 部署后的地址
# 例如：https://binance-grid-worker.your-subdomain.workers.dev
WORKER_URL=https://your-worker.workers.dev

# 用户 ID（每个用户唯一，用于区分不同账号）
USER_ID=zhuzhu

# 更新密钥（通过以下命令设置，不要写入此文件）
# wrangler secret put UPDATE_SECRET
UPDATE_SECRET=请在 .env 文件中删除此行，改用命令行设置

# ========== 可选 ==========

# Bark 推送 Key（可选，User ID 首次注册时会用到）
# BARK_KEY=你的BarkKey
